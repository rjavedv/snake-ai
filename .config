## Possible values : openrouter    OR   ollama
AI_PROVIDER=openrouter

## Some Ollama model names to try
# kev:27b-nvfp4
# clef-flash:9b-mxfp8 
# tev1:4b-mlx-bf16 
LOCAL_AI_MODEL_NAME='kev:27b-nvfp4'

## Some open router decision model names to try
# cloudflare/clairic
# microsoft/microsoft-decision-1
# perplexity/pplx-decider-flash-v1.2
# perplexity/pplx-decider-v1.2
# liquid/d1-ultra
# typesafe/jev-1.14
# typesafe/jev-1.13
OPENROUTER_MODEL_NAME='microsoft/microsoft-decision-1'

OLLAMA_BASE_URL='http://localhost:11434'
AI_TIMEOUT_SECONDS=120
AI_LOG_DIR=logs
## Possible range: -10 to 10, where -10 is slowest and 10 is fastest. Default is 0.
GAME_SPEED='-5'

# Base URL only; the app appends /v1/systemone.
OPENROUTER_BASE_URL='https://openrouter.ai/api'
